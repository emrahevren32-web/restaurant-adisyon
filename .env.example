# ═══════════════════════════════════════════════════════════════════════════
# MİYOP · ortam değişkenleri ŞABLONU
#
# Bu dosya git'e girer ve GERÇEK ANAHTAR İÇERMEZ.
# Kendi makinende `.env.local` adında bir kopya oluşturup değerleri oraya yaz.
# `.env.local` .gitignore'da; asla git'e girmez.
# ═══════════════════════════════════════════════════════════════════════════

# Supabase → Project Settings → API Keys → Project URL
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API Keys → anon / public
# Bu anahtar tarayıcıya gitmek üzere tasarlanmıştır; gizli değildir.
# Koruma RLS politikalarından gelir, anahtarın gizliliğinden değil.
VITE_SUPABASE_ANON_KEY=buraya_anon_public_anahtari

# ───────────────────────────────────────────────────────────────────────────
# service_role anahtarı BURAYA VE HİÇBİR YERE yazılmaz.
# O anahtar RLS'i tamamen atlar; tarayıcıya ulaşırsa tüm müşterilerin verisi
# açığa çıkar. Yalnızca sunucu tarafı işler için, o da ileride.
# ───────────────────────────────────────────────────────────────────────────
